# Required: GitHub personal access token with public repo read access
# Used at build time to fetch profile + pinned repos from GitHub GraphQL API
# This is NOT exposed to the client (no VITE_ prefix)
GITHUB_ACCESS_TOKEN=ghp_your_token_here

# Required: URL of the Cloudflare Worker handling shortlinks + API
VITE_WORKER_URL=https://personal-website-worker.rkkautsar.workers.dev

# Required: API secret for authenticating with the worker's protected endpoints
API_SECRET=<placeholder>
