{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node --env-file-if-exists=.env --experimental-strip-types scripts/fetch-github.ts",
    "prebuild": "node --env-file-if-exists=.env --experimental-strip-types scripts/fetch-github.ts",
    "build": "npm run lint && vite build",
    "postbuild": "node scripts/generate-blog.mjs && node --experimental-strip-types scripts/generate-redirects.ts",
    "preview": "wrangler pages dev dist --d1 DB=00000000-0000-0000-0000-000000000001 --compatibility-date=2024-09-23 --port 8789 --binding TURNSTILE_SITE_KEY=1x00000000000000000000AA --binding TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA",
    "prepare": "husky",
    "format": "prettier --write '**/*.{ts,tsx}'",
    "format:check": "prettier --check '**/*.{ts,tsx}'",
    "cron:dev": "wrangler dev --config worker/cron/wrangler.toml --port 8788",
    "deploy:cron": "wrangler deploy --config worker/cron/wrangler.toml",
    "deploy:pages": "wrangler pages deploy dist --project-name personal-website",
    "lint": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:worker": "tsc -p worker/cron/tsconfig.json",
    "d1:local:migrate": "wrangler d1 migrations apply personal-website-local --local --config wrangler.local.toml",
    "check:discussion": "tsc --noEmit --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler --allowImportingTsExtensions --types @cloudflare/workers-types functions/api/discussion/[slug].ts functions/dashboard/comments.ts functions/dashboard/index.ts",
    "test:discussion": "node --experimental-strip-types --test test/discussion-security.test.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": "prettier --write"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "jose": "^6.2.13",
    "lucide-react": "^0.395.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "@csstools/postcss-relative-color-syntax": "^2.0.16",
    "@resvg/resvg-js": "^2.6.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.10",
    "satori": "^0.63.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5",
    "vite": "^5.2.11",
    "wrangler": "^3.57.0"
  }
}
