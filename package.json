{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node --env-file-if-exists=.env --experimental-strip-types scripts/fetch-github.ts && node --env-file-if-exists=.env --experimental-strip-types scripts/generate-static-data.ts",
    "prebuild": "node --env-file-if-exists=.env --experimental-strip-types scripts/fetch-github.ts && node --env-file-if-exists=.env --experimental-strip-types scripts/generate-static-data.ts",
    "build": "npm run lint && vite build",
    "postbuild": "node --experimental-strip-types scripts/generate-redirects.ts",
    "preview": "vite preview",
    "cron:dev": "wrangler dev --config worker/cron/wrangler.toml --port 8788",
    "deploy:cron": "wrangler deploy --config worker/cron/wrangler.toml",
    "deploy:pages": "wrangler pages deploy dist --project-name personal-website",
    "lint": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:worker": "tsc -p worker/cron/tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "lucide-react": "^0.395.0",
    "react-markdown": "^10.1.0",
    "react": "^18",
    "react-dom": "^18",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "@csstools/postcss-relative-color-syntax": "^2.0.16",
    "@types/node": "^26.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^5.2.11",
    "wrangler": "^3.57.0"
  }
}
